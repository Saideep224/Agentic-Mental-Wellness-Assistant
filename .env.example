# Esona - Root Environment Variables Example
# Copy appropriate variables to backend/.env and frontend/.env.local respectively.

# ==================================================
# BACKEND SETTINGS (backend/.env)
# ==================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/esona
# For local SQLite: sqlite+aiosqlite:///./esona.db

# OpenAI API Key (Optional if using Gemini)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Gemini API Key (Required for mental wellness companion)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter (Optional, set USE_OPENROUTER=false to use Gemini directly)
USE_OPENROUTER=false
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ==================================================
# FRONTEND SETTINGS (frontend/.env.local)
# ==================================================
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-nextauth-secret-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
